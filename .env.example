# Copy this file to .env and fill in real values for local development.
# .env is gitignored and must never be committed.

# Postgres connection string. Matches docker-compose.yml defaults.
DATABASE_URL="postgresql://trackyard:trackyard@localhost:5432/trackyard?schema=public"

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Object storage (Cloudflare R2 / S3-compatible). Optional in local dev —
# when unset, uploads fall back to local disk storage (src/lib/storage.ts).
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""
