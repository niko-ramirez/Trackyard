# Copy this file to .env and fill in real values for local development.
# .env is gitignored and must never be committed.

# Postgres connection string. Matches docker-compose.yml defaults.
DATABASE_URL="postgresql://trackyard:trackyard@localhost:5432/trackyard?schema=public"

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Object storage (Cloudflare R2 / S3-compatible), used from Phase 2 onward.
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
